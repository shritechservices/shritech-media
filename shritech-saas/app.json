{
  "expo": {
    "name": "ShriTech AutoPost",
    "slug": "shritech-saas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "shritech",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6FBF4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shritech.saas",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose reels and images to upload to your posting library."
      }
    },
    "android": {
      "package": "com.shritech.saas",
      "adaptiveIcon": {
        "backgroundColor": "#14532D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose reels and images to upload to your posting library."
        }
      ]
    ],
    "runtimeVersion": "exposdk:58.0.0",
    "experiments": {
      "baseUrl": "/shritech-media"
    },
    "extra": {
      "eas": {
        "projectId": "3ad849f4-cd57-48f2-9669-8e6d56d364b6"
      }
    },
    "owner": "shritechservices",
    "updates": {
      "url": "https://u.expo.dev/3ad849f4-cd57-48f2-9669-8e6d56d364b6"
    }
  }
}
